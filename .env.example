OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MAX_RETRIES=2
# OPENAI_MAX_OUTPUT_TOKENS=8192
# OPENAI_REASONING_SUMMARIES=true
# OPENAI_PDF_INPUT=text
# TITLE_MODEL=   (default: gpt-5.4-nano on OpenAI, OPENAI_MODEL on a custom OPENAI_BASE_URL)
# DEFAULT_SYSTEM_PROMPT=   (built-in default: see docs/default-prompt.md; empty = none)
# COMPACT_THRESHOLD=150000   (OpenAI only)
# CONTEXT_TOKENS=32000   (without compaction: most history sent; default 32000 on a custom endpoint, 0 = no limit)
# BRAVE_API_KEY=
# MAX_TOOL_CALLS=8
DB_PATH=chitchat.db
# ATTACHMENTS_DIR=attachments
